# Local development configuration. Copy to .env (`make setup`) and adjust.
# These are placeholders only — never put a real credential in this file.

PORT=8080

# Local Redis from docker-compose.yml. If port 6379 is already in use, start it
# with `REDIS_PORT=6380 docker compose up -d redis` and set REDIS_ADDR to match.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# How long a cached business may be served. Review writes invalidate the entry
# explicitly; this TTL is the backstop for an invalidation that fails.
REDIS_BUSINESS_TTL_SECONDS=300

# Google sign-in. The audience of every accepted ID token must equal this value,
# so it has to be set for /api/v1/auth/google to work at all.
GOOGLE_CLIENT_ID=local-placeholder.apps.googleusercontent.com
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
GOOGLE_HTTP_TIMEOUT_SECONDS=5

# Paystack. The secret key also keys webhook signature verification, so an
# empty value causes every webhook to be rejected.
PAYSTACK_SECRET_KEY=sk_test_local_placeholder
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_HTTP_TIMEOUT_SECONDS=5
