PORT=8080

# Local Redis (started by docker compose)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_BUSINESS_TTL_SECONDS=300

# Provider configuration. Leave secrets blank unless manually testing.
GOOGLE_CLIENT_ID=
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_HTTP_TIMEOUT_SECONDS=5
